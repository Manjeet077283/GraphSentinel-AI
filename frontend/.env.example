# GraphSentinel AI - Frontend Environment Variables

# Local Development (defaults to http://127.0.0.1:8000 to ensure IPv4 loopback connectivity):
VITE_API_URL=http://127.0.0.1:8000

# Production (Set to your deployed backend API URL):
# VITE_API_URL=https://api.graphsentinel.ai

# Production Same-Domain / Reverse-Proxy (leave empty to use same-origin relative URLs):
# VITE_API_URL=
