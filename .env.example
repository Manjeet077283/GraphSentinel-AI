# =============================================================================
# GraphSentinel AI - Environment Configuration Template
# For production: Supply these variables via your cloud hosting provider's dashboard.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# =============================================================================

# Deployment Environment ('development' or 'production')
ENVIRONMENT=development

# Server Port & Binding (Standard cloud platforms inject PORT automatically)
PORT=8000
API_PORT=8000
API_HOST=0.0.0.0

# Allowed CORS Origins (Comma-separated list of allowed frontend domains)
# Local: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Production example: https://app.graphsentinel.ai,https://graphsentinel.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# API Documentation toggle (/docs and /redoc enabled in dev, optional in prod)
ENABLE_DOCS=true

# -----------------------------------------------------------------------------
# FalkorDB Database Connection
# -----------------------------------------------------------------------------
# For Local Docker Container (default):
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=graphsentinel
FALKORDB_SSL=false

# For FalkorDB Cloud (TLS enabled):
# FALKORDB_HOST=db.xyz.falkordb.cloud
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your-falkordb-cloud-password
# FALKORDB_SSL=true

# Alternative: Direct Connection URL (overrides separate host/port fields if set)
# FALKORDB_URL=rediss://default:your-falkordb-cloud-password@db.xyz.falkordb.cloud:6379

# -----------------------------------------------------------------------------
# Optional Google Gemini AI Integration
# -----------------------------------------------------------------------------
# If omitted or invalid, GraphSentinel AI operates in deterministic graph-grounded fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Security & Administrative Protection
# -----------------------------------------------------------------------------
# Admin authorization secret for the /api/admin/seed endpoint
# REQUIRED in production. Generate a strong random key (e.g., openssl rand -hex 24)
ADMIN_SECRET=your-secure-admin-secret-here

# Optional: Initial password for the seeded Lead SRE account (sre@graphsentinel.ai)
# Defaults to SREAdmin2026! if omitted during initial bootstrap
INITIAL_ADMIN_PASSWORD=
