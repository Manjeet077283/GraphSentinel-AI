# FalkorDB Connection Settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=graphsentinel

# Server Settings
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional Google Gemini AI Integration
# If omitted or invalid, GraphSentinel AI operates in deterministic graph-grounded fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Admin protection for seeding endpoint
ADMIN_SECRET=graphsentinel-admin-dev
